@{
    ViewBag.Title = "Đặt lại mật khẩu";
    Layout = "~/Views/Shared/_LayoutUser.cshtml";
}
<head>
    <link rel="stylesheet" href="~/Content/login.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.css" />
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.js"></script>
</head>

<div class="login-wrapper">
    <div class="login-container">
        <div class="login-left">
            <div class="login-image">
                <img src="~/images/mau29.jpg" alt="trang sức cao cấp" class="img-fluid" />
            </div>
        </div>

        <div class="login-right">
            <div class="login-form-wrapper">
                <h5>ĐẶT LẠI MẬT KHẨU</h5>

                @using (Html.BeginForm("ResetPassword", "tai_khoan", FormMethod.Post, new { id = "resetPasswordForm" }))
                {
                    @Html.AntiForgeryToken()
                    @Html.Hidden("email", (string)ViewBag.Email)
                    @Html.Hidden("token", (string)ViewBag.Token)
                    <div class="form-fields-center">
                        <div class="form-group">
                            <label for="matKhauMoi">Mật khẩu mới:</label>
                            <div class="password-container">
                                <input type="password" name="matKhauMoi" id="matKhauMoi" class="form-control" required />
                                <button type="button" class="toggle-password" onclick="togglePasswordVisibility('matKhauMoi', this)">
                                    <i class="fa-solid fa-eye"></i>
                                </button>
                            </div>
                            <small id="matKhauMoiError" style="color: red;"></small>
                        </div>

                        <div class="form-group">
                            <label for="xacNhanMatKhau">Xác nhận mật khẩu:</label>
                            <div class="password-container">
                                <input type="password" name="xacNhanMatKhau" id="xacNhanMatKhau" class="form-control" required />
                                <button type="button" class="toggle-password" onclick="togglePasswordVisibility('xacNhanMatKhau', this)">
                                    <i class="fa-solid fa-eye"></i>
                                </button>
                            </div>
                            <small id="xacNhanMatKhauError" style="color: red;"></small>
                        </div>
                        </div>
                        <div class="button-container">
                            <button type="submit" class="btn btn-login">Đặt lại mật khẩu</button>
                        </div>
                        }

                        @if (ViewBag.Message != null)
                        {
                            <p>@ViewBag.Message</p>
                        }
                    </div>
                </div>
    </div>
</div>

<script>
    function togglePasswordVisibility(inputId, icon) {
        const passwordField = document.getElementById(inputId);
        const eyeIcon = icon.querySelector("i");

        if (passwordField.type === "password") {
            passwordField.type = "text";
            eyeIcon.classList.remove("fa-eye");
            eyeIcon.classList.add("fa-eye-slash");
        } else {
            passwordField.type = "password";
            eyeIcon.classList.remove("fa-eye-slash");
            eyeIcon.classList.add("fa-eye");
        }
    }

    $(document).ready(function () {
        $('#resetPasswordForm').on('submit', function (e) {
            const matKhauMoi = $('#matKhauMoi').val();
            const xacNhanMatKhau = $('#xacNhanMatKhau').val();

            // Xóa lỗi cũ
            $('#matKhauMoiError').text('');
            $('#xacNhanMatKhauError').text('');

            if (matKhauMoi !== xacNhanMatKhau) {
                e.preventDefault();

                $('#xacNhanMatKhauError').text('Mật khẩu xác nhận không khớp.');

                toastr.options = {
                    "closeButton": true,
                    "progressBar": true,
                    "positionClass": "toast-bottom-right",
                    "timeOut": 4000
                };
                toastr.error('Đặt lại mật khẩu không khớp');
            }
        });
    });
</script>
